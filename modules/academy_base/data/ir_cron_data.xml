<?xml version="1.0" encoding="UTF-8"?>

<odoo noupdate="0">

  <record id="ir_cron_remove_temporary_student_enrollments" model="ir.cron">
    <field name="name">Remove temporary student enrolments</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="nextcall"
      eval="(DateTime.now().replace(minute=0, second=0, microsecond=0) + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    <field name="model_id" ref="model_academy_training_action_enrolment"/>
    <field name="code">model.remove_temporary_student_enrolments()</field>
    <field name="state">code</field>
    <field name="active" eval="True"/>
  </record>

  <record id="ir_cron_academy_maintenance_task" model="ir.cron">
    <field name="name">Academy maintenance task</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="nextcall"
      eval="(DateTime.now().replace(minute=0, second=0, microsecond=0) + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    <field name="model_id" ref="model_academy_maintenance_task"/>
    <field name="code">model.perform_maintenance()</field>
    <field name="state">code</field>
    <field name="active" eval="True"/>
    <field name="user_id" ref="base.user_admin"/>
  </record>

</odoo>
