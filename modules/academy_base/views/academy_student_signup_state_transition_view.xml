<?xml version="1.0" encoding="UTF-8"?>

<odoo noupdate="0">

  <!-- VIEWS: "Sign-up history"

       - Model·········: academy.student.signup.state.transition
       - _rec_name·····: id
       - Domain········: []
       - Context·······: {}
       - View priority·: 16    Sequence····: 10
       - Action help···: No sign-up history entries have been registered yet
   - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

  <!-- List view for "academy.student.signup.state.transition" -->
  <record id="view_academy_student_signup_state_transition_list" model="ir.ui.view">
    <field name="name">view.academy.student.signup.state.transition.list</field>
    <field name="model">academy.student.signup.state.transition</field>
    <field name="type">list</field>
    <field name="mode">primary</field>
    <field name="priority" eval="16"/>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <list string="academy_student_signup_state_transition_list"
        create="0" delete="0" edit="0">
        <field name="signup_id" class="oe_field_signup_id" optional="hide"/>
        <field name="timestamp" class="oe_field_timestamp"/>
        <field name="state" class="oe_field_state"/>
        <field name="enrolment_id" class="oe_field_enrolment_id" optional="show"/>
      </list>
    </field>
  </record>

  <!-- Form view for "academy.student.signup.state.transition" -->
  <record id="view_academy_student_signup_state_transition_form" model="ir.ui.view">
    <field name="name">view.academy.student.signup.state.transition.form</field>
    <field name="model">academy.student.signup.state.transition</field>
    <field name="type">form</field>
    <field name="mode">primary</field>
    <field name="priority" eval="16"/>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <form string="academy_student_signup_state_transition_form"
        create="0" delete="0" edit="0">
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="signup_id" class="oe_field_signup_id"/>
            </h1>
          </div>

          <group col="4">
            <group col="2" colspan="2">
              <field name="state" class="oe_field_state"/>
            </group>
            <group col="2" colspan="2">
              <field name="timestamp" class="oe_field_timestamp"/>
            </group>
            <group col="2" colspan="4" invisible="not enrolment_id">
              <field name="enrolment_id" class="oe_field_enrolment_id"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Search view for "academy.student.signup.state.transition" -->
  <record id="view_academy_student_signup_state_transition_search" model="ir.ui.view">
    <field name="name">view.academy.student.signup.state.transition.search</field>
    <field name="model">academy.student.signup.state.transition</field>
    <field name="type">search</field>
    <field name="mode">primary</field>
    <field name="priority" eval="16"/>
    <field name="active" eval="True"/>
    <field name="arch" type="xml">
      <search string="academy_student_signup_state_transition_search">
        <field name="signup_id"/>
        <field name="timestamp"/>
        <field name="state"/>
        <field name="enrolment_id"/>
        <group expand="1" string="Group By">
          <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
          <filter name="group_by_signup_id" string="Sign-up" context="{'group_by': 'signup_id'}"/>
          <filter name="group_by_enrolment_id" string="Enrolment" context="{'group_by': 'enrolment_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Main window action for "academy.student.signup.state.transition" -->
  <record id="action_student_signup_history_act_window"
    model="ir.actions.act_window">
    <field name="type">ir.actions.act_window</field>
    <field name="name">Sign-up history</field>
    <field name="res_model">academy.student.signup.state.transition</field>
    <field name="view_mode">list,form</field>
    <field name="target">current</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
    <field name="search_view_id"
      ref="view_academy_student_signup_state_transition_search"/>
    <field name="help" type="html">
      <p>No sign-up history entries have been registered yet.</p>
    </field>
  </record>

</odoo>
